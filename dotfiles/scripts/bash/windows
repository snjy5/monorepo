#!/usr/bin/env bash

memory="4G"
accel="kvm"
cpu="host"
vga="virtio"
file="${HOME}/ALL/windows/windows.qcow2"

opts=(
    -m "$memory"
    -accel "$accel"
    -cpu "$cpu"
    -drive file="${file},index=1"
    -vga "$vga"
    -smp "4"
)

nice -n 20 ionice -c 2 taskset -c 0-7 qemu-system-x86_64 "${opts[@]}"
