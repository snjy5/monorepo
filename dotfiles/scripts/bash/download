#!/usr/bin/env bash

# Check if URL is specified
[ "$#" -eq 0 ] && printf "%s\n" "URL not specified" && exit 1

url="$1"

# Get the remote filename
reqname="$(curl -sLI -H "User-Agent: Mozilla/5.0" "$url" | grep -Ezo 'filename=[^ \n]*(\s|$)' | awk -F '=' '{print $2}')"

# If remote filename is not found, use the last part of the effective URL
[ -z "$reqname" ] && \
	reqname=$(curl -sLI -w '%{url_effective}' -H "User-Agent: Mozilla/5.0" "$url" | tail -1 | xargs basename | sed 's/?.*//g')

# Clean up the filename
filename="$(printf "%s" "$reqname" | sed -E -e 's/\[.*\]//g' -e 's/\(.*\)//g' -e 's/\\//g' -e 's/[[:space:]]/_/g' -e 's/-/_/g' -e 's/[^[:alnum:]_.-]//g' -e 's/.*/\L&/g' -e 's/_$//g')"

# Check if filename is empty and exit if there's a network issue or the site is down
[ -z "$filename" ] && printf "%s\n" "Network issue or site is down?" && exit 1

# Display the saving location
printf "%s\n" "Saving to $PWD/$filename"

# Download the file with aria2c
aria2c -c -j"$(nproc --all)" -k1M -m0 -x1 -s16 --max-download-limit=10M --user-agent="Mozilla/5.0" "$url" -o "$filename"
