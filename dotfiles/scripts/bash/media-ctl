#!/usr/bin/env bash
# ==============================================================================
# media-ctl: Universal Streaming, Download, Transcode & Playback Engine
# ==============================================================================
set -euo pipefail

PROG_NAME="media-ctl"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/media-ctl"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/media-ctl"
mkdir -p "$CACHE_DIR" "$DATA_DIR"

log_info()  { printf "[INFO]  %s\n" "$*" >&2; }
log_warn()  { printf "[WARN]  %s\n" "$*" >&2; }
log_error() { printf "[ERROR] %s\n" "$*" >&2; }

# ------------------------------------------------------------------------------
# 1. Download Acceleration Engine
# ------------------------------------------------------------------------------
download_asset() {
    local url="${1:-}"
    local out_name="${2:-}"

    [[ -z "$url" ]] && { log_error "URL required for download."; return 1; }

    # Resolve filename if not supplied
    if [[ -z "$out_name" ]]; then
        local remote_name
        remote_name=$(curl -sLI -A "Mozilla/5.0" "$url" | grep -Ei '^content-disposition:.*filename=' | tail -1 | sed -E 's/.*filename=["'\''"]?([^"'\'' ;]+).*/\1/' || true)
        if [[ -z "$remote_name" ]]; then
            remote_name=$(curl -sLI -w '%{url_effective}' -A "Mozilla/5.0" "$url" | tail -1 | xargs -r basename | sed 's/[?#].*//')
        fi
        out_name="${remote_name:-download_$(date +%s)}"
    fi

    # Clean filename
    out_name=$(printf "%s" "$out_name" | tr ' /:;&*?|' '_______' | tr '[:upper:]' '[:lower:]')
    printf "Saving to: %s/%s\n" "$PWD" "$out_name"

    # Multi-engine download fallback
    if command -v aria2c >/dev/null 2>&1; then
        local cores
        cores=$(nproc 2>/dev/null || echo 4)
        aria2c -c -j"$cores" -x16 -s16 -k1M --file-allocation=none --user-agent="Mozilla/5.0" "$url" -o "$out_name"
    else
        log_info "'aria2c' not found, falling back to curl streaming resume."
        local offset=0
        [[ -f "$out_name" ]] && offset=$(stat -c%s "$out_name" 2>/dev/null || stat -f%z "$out_name" 2>/dev/null || echo 0)
        curl -A "Mozilla/5.0" -C "$offset" -fSL "$url" -o "$out_name"
    fi
}

# ------------------------------------------------------------------------------
# 2. YouTube & Stream Extraction Engine
# ------------------------------------------------------------------------------
play_stream() {
    local mode="$1" # audio | video | cached
    local query="$2"

    local resolved_url="$query"

    # Support ytfzf search if query is not a direct URL
    if [[ ! "$query" =~ ^https?:// ]] && command -v ytfzf >/dev/null 2>&1; then
        resolved_url=$(ytfzf -L "$query" 2>/dev/null | head -n1 || true)
        [[ -z "$resolved_url" ]] && { log_error "No stream matches found."; return 1; }
    fi

    case "$mode" in
        audio)
            mpv --no-video --no-audio-display --ytdl-format="bestaudio/best" "$resolved_url"
            ;;
        video)
            mpv --ytdl-format="bestvideo+bestaudio/best" "$resolved_url"
            ;;
        cached)
            local title
            title=$(yt-dlp --print title "$resolved_url" 2>/dev/null || echo "stream_$(date +%s)")
            local safe_title
            safe_title=$(printf "%s" "$title" | tr ' /:;&*?|' '_______')
            local cached_file="${CACHE_DIR}/${safe_title}.m4a"

            if [[ -f "$cached_file" ]]; then
                log_info "Playing from cache: $cached_file"
                mpv --no-video "$cached_file"
            else
                log_info "Downloading to cache..."
                yt-dlp -f "bestaudio[ext=m4a]/bestaudio/best" -o "$cached_file" "$resolved_url"
                mpv --no-video "$cached_file"
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 3. Transcode & Audio Processing
# ------------------------------------------------------------------------------
transcode_media() {
    local action="$1" # oggify | optimise
    shift

    case "$action" in
        oggify)
            # Transcodes all non-ogg audio in target or current directory to high-efficiency Vorbis
            local target_dir="${1:-.}"
            find "$target_dir" -type f ! -name "*.ogg" ! -name "*.txt" | while IFS= read -r f; do
                local out="${f%.*}.ogg"
                log_info "Transcoding: $f -> $out"
                ffmpeg -y -hide_banner -nostdin -i "$f" -vn -c:a libvorbis -q:a 4 "$out" && rm -f "$f"
            done
            ;;
        optimise)
            local infile="${1:-}"
            local outfile="${2:-}"
            [[ -z "$infile" || -z "$outfile" ]] && { log_error "Usage: media-ctl transcode optimise <in> <out>"; return 1; }
            ffmpeg -i "$infile" -c:v libx265 -crf 28 -preset medium -c:a copy "$outfile"
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 4. Webcam & Local Audio Keep-Alives
# ------------------------------------------------------------------------------
open_webcam() {
    local dev="${1:-/dev/video0}"
    [[ ! -c "$dev" ]] && { log_error "Video device '$dev' not found."; return 1; }
    mpv "av://v4l2:$dev" --profile=low-latency --untimed --vf=lavfi=hflip
}

keep_audio_alive() {
    # Emits silent stream to prevent DAC/Bluetooth powersave sleep pops
    log_info "Emitting silence loop to keep audio hardware awake. [Ctrl+C] to stop."
    ffmpeg -y -f lavfi -t 5 -i anullsrc=r=44100:cl=stereo -c:a pcm_s16le /tmp/media_ctl_zero.wav >/dev/null 2>&1
    while true; do
        aplay -q /tmp/media_ctl_zero.wav 2>/dev/null || paplay /tmp/media_ctl_zero.wav 2>/dev/null || sleep 5
    done
}

# ------------------------------------------------------------------------------
# 5. CLI Handling
# ------------------------------------------------------------------------------
show_help() {
    cat <<EOF
$PROG_NAME: Universal Media Playback, Extraction & Transcoding CLI

Usage:
  $PROG_NAME <command> [arguments]

Commands:
  get       <url> [output]               Fast multi-threaded download (aria2c/curl)
  play      <audio|video|cached> <url>   Stream or stream-cache YouTube/Invidious
  radio     [search_query]               Shuffle play curated or searched audio
  transcode <oggify [dir]|optimise in out> Bulk convert audio or re-encode video
  webcam    [device]                     Low-latency mirrored camera monitor
  audio-alive                            Loop silence to prevent DAC power down
  shuf      <dir>                        Play media files in random order

Examples:
  $PROG_NAME get "https://example.com/file.zip"
  $PROG_NAME play audio "lofi hip hop"
  $PROG_NAME transcode oggify ~/Music
EOF
    exit 0
}

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        get|download|save)
            download_asset "$@"
            ;;
        play)
            local mode="${1:-audio}"
            shift || true
            play_stream "$mode" "$*"
            ;;
        radio)
            play_stream audio "${1:-chillhop}"
            ;;
        transcode)
            transcode_media "$@"
            ;;
        webcam)
            open_webcam "${1:-/dev/video0}"
            ;;
        audio-alive)
            keep_audio_alive
            ;;
        shuf)
            local target="${1:-.}"
            find "$target" -type f | shuf | mpv --playlist=- --no-video
            ;;
        *)
            show_help
            ;;
    esac
}

main "$@"

