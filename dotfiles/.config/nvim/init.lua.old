-- white colorscheme
-- cmd 'colorscheme zellner'

-- Override some colors
-- cmd 'hi Normal guibg=#F4E8D7 guifg=#000000'
--cmd 'hi Normal guibg=#000000 guifg=#FFFFFF'
cmd 'hi Normal guibg=#000000 guifg=#AAAAAA'
-- cmd 'hi Normal guifg=#c9d1d9 guibg=#0d1117'
cmd 'hi NonText guifg=bg guibg=bg ctermfg=NONE ctermbg=NONE'
cmd 'hi EndOfBuffer guibg=bg guifg=bg ctermfg=NONE ctermbg=NONE'
cmd 'hi SignColumn guifg=bg guibg=bg ctermbg=NONE ctermfg=NONE'

-- Ale colors
cmd 'hi ALEErrorSign guifg=red guibg=none'
cmd 'hi ALEStyleErrorSign guifg=red guibg=none'
cmd 'hi ALESignColumnWithErrors guifg=red guibg=red'
cmd 'hi ALEWarningSign guifg=red guibg=none'
cmd 'hi ALEStyleWarningSign guifg=none guibg=none'
cmd 'hi ALEInfoSign guifg=#666666 guibg=none'

