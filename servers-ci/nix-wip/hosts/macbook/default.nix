# Bare metal: MacBook Pro 11,1 (13" Retina, 2013/2014, Haswell), LUKS + btrfs.
{ inputs, ... }:

{
  imports = [
    ./hardware-configuration.nix # generated by nixos-generate-config
    ./filesystems.nix
    inputs.nixos-hardware.nixosModules.apple-macbook-pro-11-1
  ];

  networking.hostName = "nixos";
  system.stateVersion = "26.05";

  custom = {
    target = "macbook";
    hasGui = true;
    power.disableSleep = true;
    btrfs.snapshots.enable = true;
    androidPhone.enable = true;
  };
}
